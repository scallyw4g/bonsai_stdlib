in vec2 UV;
flat in vec3 VertColor;
flat in int TextureSlice;
flat in uint Flags;

out vec4 color;

uniform highp sampler2D UiTexture2D;
uniform highp sampler2DArray UiTextureArray;

const uint MultiplyColor = 1u << 0;
const uint HasAlpha = 1u << 1;
const uint DepthTexture = 1u << 2;

void main()
{
  vec4 Texel;
  if (TextureSlice < 0)
  {
    Texel = texture(UiTexture2D, UV);
  }
  else
  {
    Texel = texture(UiTextureArray, vec3(UV, float(TextureSlice)));
  }

  if ((Flags & DepthTexture) != 0u)
  {
    color = vec4(vec3(Linearize(Texel.r, 500.0, 0.1)), 1.0);
  }
  else if ((Flags & MultiplyColor) != 0u)
  {
    color = vec4(VertColor * Texel.rgb, Texel.a);
  }
  else
  {
    color = vec4(Clamp01(Texel.rgb) + VertColor, (Flags & HasAlpha) != 0u ? Texel.a : 1.0);
  }
}
